# ========================================================
# IQ Option Credentials
# ========================================================
IQ_EMAIL=your_email@example.com
IQ_PASSWORD=your_password

# Mode: PRACTICE (Demo) or REAL
ACCOUNT_MODE=PRACTICE

# ========================================================
# Trading & Money Management
# ========================================================
# Only trade pairs with payout >= 88% and take top 5
MIN_PAYOUT=88
TOP_PAIRS_COUNT=5

# Base Bet (USD)
BASE_BET=1.0

# Martingale: 5 steps max (1.0 -> 2.2 -> 5.0 -> 11.0 -> 25.0)
MARTINGALE_STEPS=5
MARTINGALE_MULTIPLIER=2.2
CUSTOM_STEPS=1.0,2.2,5.0,11.0,25.0

# Risk Limits (USD)
DAILY_STOP_LOSS=50.0
DAILY_TAKE_PROFIT=30.0

# Expiration time in minutes (1 or 5)
EXPIRY_MINUTES=1

# ========================================================
# Technical Strategy: Multi-Timeframe Trend + Pullback
# ========================================================
EMA_TREND_PERIOD=50
BB_PERIOD=20
BB_STD_DEV=2.0
RSI_PERIOD=7
RSI_OVERSOLD=35.0
RSI_OVERBOUGHT=65.0

# ========================================================
# Telegram Notification
# Get Token from @BotFather, Chat ID from @userinfobot
# ========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ========================================================
# Web Dashboard
# ========================================================
WEB_HOST=127.0.0.1
WEB_PORT=8000
